{
  "name": "mongo-hive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "tsx --env-file=.env scripts/seed.ts",
    "ping": "tsx --env-file=.env scripts/ping.ts",
    "mcp": "tsx --env-file=.env src/mcp/server.ts",
    "typecheck": "tsc --noEmit",
    "status": "tsx --env-file=.env scripts/hive-status.ts",
    "hive": "tsx --env-file=.env scripts/hive.ts",
    "web": "npm --prefix web run dev",
    "improve": "tsx --env-file=.env scripts/improve.ts",
    "worker-draft": "tsx --env-file=.env scripts/worker-draft.ts",
    "poison": "tsx --env-file=.env fixtures/deps/mallory.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "latest",
    "langsmith": "^0.10.5",
    "mongodb": "latest",
    "openai": "^7.23.0",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
